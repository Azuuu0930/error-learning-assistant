{"id": "PY-001", "title": "変数名のタイプミス", "difficulty": "beginner", "code": "username = \"Taro\"\nprint(user_name)\n", "expected": {"execution": "error", "exception_type": "NameError", "should_warn": true}, "analysis_expectations": {"should_detect": ["未定義変数 user_name", "類似候補 username"], "should_not_claim": ["username が確実な正解"]}}
